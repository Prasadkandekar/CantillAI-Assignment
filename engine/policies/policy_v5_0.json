{
  "schema_version": 1,
  "version": "5.0",
  "effective_from": "2026-04-01",
  "title": "Corvo Engineering Procurement Policy PR to PO",
  "source": {"document": "CORVO-PROC-POL-04", "owner": "Head of Procurement",
             "notes": "Applies to plants PUN1 (Bhosari) and CHK1 (Chakan). Values in INR excluding GST."},
  "parameters": {
    "club_keys": ["item_code", "plant"],
    "club_created_days": 14,
    "club_needby_days": 7,
    "club_new_items": false,
    "urgency_values": ["Normal", "Emergency"],
    "emergency_urgency_values": ["Emergency"],
    "valuation_ladder": ["contract", "last_po", "standard_price"],
    "new_item_valuation": "requester_estimate",
    "price_history_days": 365,
    "bought_history_days": 365,
    "eligible_supplier_statuses": ["Active"],
    "emergency_max_value": 500000,
    "spot_max_value": 200000,
    "rfp_min_value": 1000000,
    "capex_suggestion_count": 5,
    "rfq_suggestion_count": 3,
    "rfp_suggestion_count": 5,
    "preferred_history_days": 548,
    "ranking_weights": {"frequency": 0.30, "recency": 0.25, "contract": 0.15, "on_time": 0.15, "quality": 0.15},
    "ranking_recency_decay_days": 180,
    "ranking_tie_break": ["recency", "quality", "supplier_id"],
    "on_time_pct_scale": 100,
    "quality_rating_scale": 5,
    "topup_weights": {"on_time": 0.5, "quality": 0.5},
    "preferred_export_count": 3,
    "consolidate_decisions": ["PO"],
    "consolidation_keys": ["supplier_id", "plant", "route"],
    "consolidation_hours": 24
  },
  "parameter_meta": {
    "club_created_days": {"clause": "2.2", "label": "Clubbing window on creation date", "unit": "days"},
    "club_needby_days": {"clause": "2.2", "label": "Clubbing window on need-by date (either side)", "unit": "days"},
    "club_new_items": {"clause": "1.2", "label": "New items may be clubbed", "unit": "flag"},
    "price_history_days": {"clause": "3.1", "label": "Price history window for valuation", "unit": "days"},
    "bought_history_days": {"clause": "5.3/5.4", "label": "Window for 'bought from an Active supplier'", "unit": "days"},
    "eligible_supplier_statuses": {"clause": "4.1/5.7", "label": "Supplier statuses allowed to receive POs or suggestions", "unit": "list"},
    "emergency_max_value": {"clause": "5.3", "label": "Emergency PO limit", "unit": "INR"},
    "spot_max_value": {"clause": "5.4", "label": "Spot PO limit", "unit": "INR"},
    "rfp_min_value": {"clause": "5.5/5.6", "label": "RFP threshold", "unit": "INR"},
    "capex_suggestion_count": {"clause": "5.1", "label": "Suppliers suggested for capex sourcing", "unit": "count"},
    "rfq_suggestion_count": {"clause": "5.5", "label": "Suppliers suggested for an RFQ", "unit": "count"},
    "rfp_suggestion_count": {"clause": "5.6", "label": "Suppliers suggested for an RFP", "unit": "count"},
    "preferred_history_days": {"clause": "6.1", "label": "Preferred-list PO history window", "unit": "days"},
    "ranking_weights": {"clause": "6.2", "label": "Preferred-supplier ranking weights", "unit": "weights"},
    "ranking_recency_decay_days": {"clause": "6.2", "label": "Recency decay constant", "unit": "days"},
    "topup_weights": {"clause": "6.4", "label": "Top-up ordering weights", "unit": "weights"},
    "consolidation_hours": {"clause": "7.1", "label": "PO consolidation window", "unit": "hours"}
  },
  "rules": [
    {"id": "1.2", "clause": "1.2",
     "text": "A line that matches no item master item is a new item. It always goes to sourcing (route NEW_ITEM_SOURCING), is never clubbed with other lines, and is valued at quantity × the requester's estimated unit price.",
     "when": {"all": [{"fact": "is_new_item", "op": "eq", "value": true}]},
     "outcome": {"decision": "SOURCING_REQUEST", "route": "NEW_ITEM_SOURCING", "supplier": {"strategy": "none"},
                 "note": "New items get no suggestions: the buyer finds suppliers (6.4)."}},
    {"id": "5.1", "clause": "5.1",
     "text": "The item type is Capex: Sourcing request, route CAPEX_SOURCING, suggest 5 suppliers (6.4). Needs capex approval.",
     "when": {"all": [{"fact": "item_type", "op": "eq", "value": "Capex"}]},
     "outcome": {"decision": "SOURCING_REQUEST", "route": "CAPEX_SOURCING",
                 "supplier": {"strategy": "suggest", "count": "$capex_suggestion_count"},
                 "note": "Needs capex approval."}},
    {"id": "5.2", "clause": "5.2",
     "text": "A contract can be used (4.1 to 4.3): PO, route CONTRACT_PO, contract supplier at contract rate.",
     "when": {"all": [{"fact": "contract_usable", "op": "eq", "value": true}]},
     "outcome": {"decision": "PO", "route": "CONTRACT_PO", "supplier": {"strategy": "contract"}}},
    {"id": "5.3", "clause": "5.3",
     "text": "Emergency, value ≤ ₹5,00,000, and the item was bought from an Active supplier in the last 365 days: PO, route EMERGENCY_PO, 1st preferred supplier (section 6) at its reference price.",
     "when": {"all": [
       {"fact": "is_emergency", "op": "eq", "value": true},
       {"fact": "group_value", "op": "lte", "value": "$emergency_max_value"},
       {"fact": "bought_from_active_365d", "op": "eq", "value": true}]},
     "outcome": {"decision": "PO", "route": "EMERGENCY_PO", "supplier": {"strategy": "preferred_first"}}},
    {"id": "5.4", "clause": "5.4",
     "text": "Value below ₹2,00,000, and the item was bought from an Active supplier in the last 365 days: PO, route SPOT_PO, 1st preferred supplier at its reference price.",
     "when": {"all": [
       {"fact": "group_value", "op": "lt", "value": "$spot_max_value"},
       {"fact": "bought_from_active_365d", "op": "eq", "value": true}]},
     "outcome": {"decision": "PO", "route": "SPOT_PO", "supplier": {"strategy": "preferred_first"}}},
    {"id": "5.5", "clause": "5.5",
     "text": "Value below ₹10,00,000 (including small items never bought in the last 365 days): Sourcing request, route RFQ, suggest 3 suppliers (6.4).",
     "when": {"all": [{"fact": "group_value", "op": "lt", "value": "$rfp_min_value"}]},
     "outcome": {"decision": "SOURCING_REQUEST", "route": "RFQ",
                 "supplier": {"strategy": "suggest", "count": "$rfq_suggestion_count"}}},
    {"id": "5.6", "clause": "5.6",
     "text": "Value ₹10,00,000 or more: Sourcing request, route RFP, suggest 5 suppliers (6.4).",
     "when": {"all": [{"fact": "group_value", "op": "gte", "value": "$rfp_min_value"}]},
     "outcome": {"decision": "SOURCING_REQUEST", "route": "RFP",
                 "supplier": {"strategy": "suggest", "count": "$rfp_suggestion_count"}}}
  ]
}
